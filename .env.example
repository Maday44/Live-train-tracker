# Network Rail Open Data (datafeeds.networkrail.co.uk)
NR_FEED_USERNAME="maday"
NR_FEED_PASSWORD=
NR_STOMP_HOST=publicdatafeeds.networkrail.co.uk
NR_STOMP_PORT=61618

# TD area topic to subscribe to, e.g. SEUS for South East.
# Find yours at https://wiki.openraildata.com/index.php/List_of_Train_Describers
TD_AREA_CODE=SEUS

# Comma-separated list of berth IDs identified as "near my home"
# (leave empty until you've completed scripts/identify_berth.py)
TARGET_BERTHS=

# Realtime Trains API (realtimetrains.co.uk/about/developer)
RTT_API_USER=
RTT_API_PASS=

# Database
DATABASE_URL=postgresql://trainwatch:trainwatch@db:5432/trainwatch

# Alerting webhook (Pushover, ntfy.sh, Telegram bot, etc.)
ALERT_WEBHOOK_URL=
